{
  "name": "taller-4-modelo-cliente-servidor-con-javascript-y-node",
  "version": "1.0.0",
  "description": "Tienda de Libros: aplicacion con Node.js y Express que implementa un CRUD de libros.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:css\"",
    "dev:server": "nodemon src/server.js",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css"
  },
  "keywords": [],
  "author": "Darwin Andres Saavedra",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "tailwindcss": "^4.3.3"
  }
}
